@page
@model AutoServiz.Pages.Javitasok.CreateModel

@{
    ViewData["Title"] = "Új javítás";
}

<h1>Új javítás</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Javitas.UgyfelId" class="control-label"></label>
                <select asp-for="Javitas.UgyfelId" class="form-control" asp-items="ViewBag.UgyfelId"></select>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Rendszam" class="control-label"></label>
                <input asp-for="Javitas.Rendszam" class="form-control" />
                <span asp-validation-for="Javitas.Rendszam" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Leiras" class="control-label"></label>
                <input asp-for="Javitas.Leiras" class="form-control" />
                <span asp-validation-for="Javitas.Leiras" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Koltseg" class="control-label"></label>
                <input asp-for="Javitas.Koltseg" class="form-control" />
                <span asp-validation-for="Javitas.Koltseg" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.Allapot" class="control-label"></label>
                <select asp-for="Javitas.Allapot" class="form-control">
                    <option>Felvéve</option>
                    <option>Folyamatban</option>
                    <option>Kész</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Javitas.FelvetelDatuma" class="control-label"></label>
                <input asp-for="Javitas.FelvetelDatuma" class="form-control" />
                <span asp-validation-for="Javitas.FelvetelDatuma" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Mentés" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Vissza a listához</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
