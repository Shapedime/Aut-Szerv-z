@page
@model AutoServiz.Pages.Ugyfelek.CreateModel

@{
    ViewData["Title"] = "Új ügyfél";
}

<h1>Új ügyfél</h1>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Ugyfel.Nev" class="control-label"></label>
                <input asp-for="Ugyfel.Nev" class="form-control" />
                <span asp-validation-for="Ugyfel.Nev" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ugyfel.Telefon" class="control-label"></label>
                <input asp-for="Ugyfel.Telefon" class="form-control" />
                <span asp-validation-for="Ugyfel.Telefon" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ugyfel.Email" class="control-label"></label>
                <input asp-for="Ugyfel.Email" class="form-control" />
                <span asp-validation-for="Ugyfel.Email" class="text-danger"></span>
            </div>
            <div class="form-group mt-2">
                <input type="submit" value="Mentés" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Vissza a listához</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
