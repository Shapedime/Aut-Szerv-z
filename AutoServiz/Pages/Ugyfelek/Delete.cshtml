@page
@model AutoServiz.Pages.Ugyfelek.DeleteModel

@{
    ViewData["Title"] = "Ügyfél törlése";
}

<h1>Ügyfél törlése</h1>

@if (Model.Hiba != "")
{
    <div class="alert alert-danger">@Model.Hiba</div>
}

<h3>Biztosan törölni akarod?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ugyfel.Nev)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ugyfel.Nev)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ugyfel.Telefon)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ugyfel.Telefon)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ugyfel.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ugyfel.Email)
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Ugyfel.Id" />
        <input type="submit" value="Törlés" class="btn btn-danger" /> |
        <a asp-page="./Index">Vissza a listához</a>
    </form>
</div>
