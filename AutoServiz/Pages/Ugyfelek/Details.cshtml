@page
@model AutoServiz.Pages.Ugyfelek.DetailsModel

@{
    ViewData["Title"] = "Ügyfél adatai";
}

<h1>Ügyfél adatai</h1>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ugyfel.Nev)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ugyfel.Nev)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ugyfel.Telefon)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ugyfel.Telefon)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Ugyfel.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Ugyfel.Email)
        </dd>
    </dl>
</div>

<h4>Javításai</h4>
<table class="table">
    <thead>
        <tr>
            <th>Rendszám</th>
            <th>Leírás</th>
            <th>Állapot</th>
            <th>Dátum</th>
            <th>Költség</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Ugyfel.Javitasok) {
        <tr>
            <td>@item.Rendszam</td>
            <td>@item.Leiras</td>
            <td>@item.Allapot</td>
            <td>@item.FelvetelDatuma.ToShortDateString()</td>
            <td>@item.Koltseg Ft</td>
        </tr>
}
    </tbody>
</table>
<p><b>Összköltség: @Model.Ugyfel.Javitasok.Sum(j => j.Koltseg) Ft</b></p>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Ugyfel.Id">Szerkesztés</a> |
    <a asp-page="./Index">Vissza a listához</a>
</div>
