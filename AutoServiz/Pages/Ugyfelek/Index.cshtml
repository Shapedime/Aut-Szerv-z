@page
@model AutoServiz.Pages.Ugyfelek.IndexModel

@{
    ViewData["Title"] = "Ügyfelek";
}

<h1>Ügyfelek</h1>

<p>
    <a asp-page="Create">Új ügyfél</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ugyfel[0].Nev)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ugyfel[0].Telefon)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Ugyfel[0].Email)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Ugyfel) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nev)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefon)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Szerkesztés</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Részletek</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Törlés</a>
            </td>
        </tr>
}
    </tbody>
</table>
